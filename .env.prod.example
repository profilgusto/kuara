# ─────────────────────────────────────────────────────────────────────────────
# Kuara Platform — Production Environment Variables
#
# 1. Copy this file:   cp .env.prod.example .env.prod
# 2. Fill in ALL values below (replace every CHANGE_ME_*)
# 3. Run first-time deploy:  ./scripts/deploy.sh
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────

# Full public HTTPS URL of the site (no trailing slash), including the
# sub-path it's served under. Must start with https://TRAEFIK_DOMAIN.
NEXT_PUBLIC_SERVER_URL=https://kuara.ufsj.edu.br/kuara

# Sub-path the app is served under (must match the Traefik PathPrefix router
# rule and the NEXT_PUBLIC_SERVER_URL suffix above).
NEXT_PUBLIC_BASE_PATH=/kuara

# Secret used to sign Payload JWTs. Long, random, never shared.
# Generate: openssl rand -hex 64
PAYLOAD_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# Password for the internal PostgreSQL user (never exposed outside Docker).
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32


# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────

# MinIO admin credentials — also used by the app as S3 access keys.
# User can be any alphanumeric string; password must be ≥ 8 chars.
# Generate password: openssl rand -hex 32
MINIO_ROOT_USER=kuara-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32


# ── Routing (Traefik + Let's Encrypt) ────────────────────────────────────────

# The domain Traefik will serve traffic on (no https://, no trailing slash).
# Must match the A/AAAA record pointing to this server's public IP.
TRAEFIK_DOMAIN=kuara.ufsj.edu.br

# Email for Let's Encrypt certificate expiry notifications.
TRAEFIK_ACME_EMAIL=admin@ufsj.edu.br


# ─────────────────────────────────────────────────────────────────────────────
# The following variables are derived automatically inside docker-compose
# from the values above — do NOT set them manually.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://kuara:${POSTGRES_PASSWORD}@postgres:5432/kuara
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=kuara-media
# S3_ACCESS_KEY=${MINIO_ROOT_USER}
# S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
