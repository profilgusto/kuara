# ─────────────────────────────────────────────────────────────────────────────
# Kuara Platform — Production Environment Variables
# Copy this file to .env.prod and fill in all values before deploying.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with real values
#   docker compose -f docker-compose.prod.yml up -d --build
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────

# Full public URL of the site (no trailing slash)
# Used for OpenGraph tags, sitemaps, and Payload's serverURL.
NEXT_PUBLIC_SERVER_URL=https://kuara.example.com

# Secret used to sign Payload JWTs. Must be long, random, and never committed.
# Generate: openssl rand -hex 64
PAYLOAD_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# Password for the kuara PostgreSQL user (used inside docker-compose only).
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32


# ── Object Storage (MinIO) ────────────────────────────────────────────────────

# MinIO admin credentials — also used by the Next.js app as S3 access keys.
# Generate passwords: openssl rand -hex 32
MINIO_ROOT_USER=kuara-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32


# ── Routing (Traefik — only needed when using docker-compose.prod.traefik.yml) ──

# Primary domain Traefik will route traffic to
TRAEFIK_DOMAIN=kuara.example.com

# Email for Let's Encrypt certificate notifications
TRAEFIK_ACME_EMAIL=admin@example.com


# ─────────────────────────────────────────────────────────────────────────────
# The following variables are automatically derived inside docker-compose and
# do NOT need to be set manually in .env.prod — they are shown here for reference.
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE_URL=postgresql://kuara:${POSTGRES_PASSWORD}@postgres:5432/kuara
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=kuara-media
# S3_ACCESS_KEY=${MINIO_ROOT_USER}
# S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
