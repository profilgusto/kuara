# ─────────────────────────────────────────────────────────────────────────────
# Kuara Platform — Development Environment Variables
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in POSTGRES_PASSWORD and PAYLOAD_SECRET (any value works for dev)
# 3. Start the stack:  docker compose up -d --build
#
# All other vars (DATABASE_URL, S3_*, NEXT_PUBLIC_SERVER_URL) are set with
# sensible defaults inside docker-compose.yml — no need to set them here.
# ─────────────────────────────────────────────────────────────────────────────

# Password for the local PostgreSQL container.
# Any string works in dev, e.g.: POSTGRES_PASSWORD=devpassword
POSTGRES_PASSWORD=

# Secret used to sign Payload CMS JWTs.
# Any string works in dev, e.g.: PAYLOAD_SECRET=devsecret
PAYLOAD_SECRET=

# Object storage (Garage) needs nothing here: docker-compose.yml ships fixed
# throwaway credentials for dev. Set GARAGE_RPC_SECRET / S3_ACCESS_KEY /
# S3_SECRET_KEY only if you want to override them.
